  "notebook_role": "Reads and displays JPG files; counts outcomes by filename suffix. No training or video inference cells.",
  "notebook_cells": [
    {
      "cell_type": "code",
      "source": "import numpy as np\nimport os\nimport matplotlib.pyplot as plt\n%matplotlib inline"
    },
    {
      "cell_type": "code",
      "source": "# 將 UR fall dataset 中 ADL 和 Fall 的測試結果的影像依序讀入它的檔名\nimport glob\nADL_path=glob.glob(r'.\\UR_Fall_dataset\\ADL\\*')\nFall_path=glob.glob(r'.\\UR_Fall_dataset\\Fall\\*')\n#ADL_path=glob.glob(r'./UR_Fall_dataset/ADL/*')\n#Fall_path=glob.glob(r'./UR_Fall_dataset/Fall/*')\nprint('number of ADL file=', len(ADL_path))\nprint('number of Fall file=', len(Fall_path))"
    },
    {
      "cell_type": "code",
      "source": "# 顯示 UR-Fall dataset ADL 影片測試結果的影像\nfor filename in ADL_path:\n    img=plt.imread(filename) \n    plt.figure(figsize=(6,3))\n    plt.imshow(img)\n    plt.axis(\"off\")\n    plt.show()"
    },
    {
      "cell_type": "code",
      "source": "# 顯示 UR Fall dataset Fall 影片測試結果的影像\nfor filename in Fall_path:\n    img=plt.imread(filename) \n    plt.figure(figsize=(6,3))\n    plt.imshow(img)\n    plt.axis(\"off\")\n    plt.show()"
    },
    {
      "cell_type": "code",
      "source": "# 計算 Accuracy 和 F1 score\nTN=0\nFP=0\nfor filename in ADL_path:\n    basename=os.path.basename(filename).split('.')[0]\n    if basename[-1]=='n':\n        TN=TN+1\n    elif basename[-1]=='a':\n        FP=FP+1\nprint('TN=', TN)\nprint('FP=', FP)\n\nTP=0\nFN=0\nfor filename in Fall_path:\n    basename=os.path.basename(filename).split('.')[0]\n    if basename[-1]=='n':\n        FN=FN+1\n    elif basename[-1]=='a':\n        TP=TP+1\nprint('TP=', TP)\nprint('FN=', FN)\n\nAccuracy=(TP+TN)/(TP+FN+TN+FP)\nprint('Accuracy=', Accuracy)\nRecall=TP/(TP+FN)\nprint('Recall=', Recall)\nPrecision=TP/(TP+FP)\nprint('Precision=', Precision)\nF1_score=2*Recall*Precision/(Recall+Precision)\nprint('F1 score=', F1_score)"
    }
  ],
