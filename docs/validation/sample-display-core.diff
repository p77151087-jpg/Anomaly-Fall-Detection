+
+    @torch.inference_mode()
+    def classify_observations(self, skeleton, frame_size_wh):
+        """Display-only original30/per-frame forward, independent of the AE recipe."""
+        points, motion = human_preprocess(skeleton, frame_size_wh, self.tolerance, 30, "per_frame")
+        self.model.eval()
+        scores = self.model(
+            (torch.from_numpy(points).to(self.device), torch.from_numpy(motion).to(self.device))
+        )
+        if scores.shape != (1, 7) or not torch.isfinite(scores).all():
+            raise ContractError("Invalid independent Human action head output")
+        return scores.cpu().numpy().copy()
